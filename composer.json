{
  "name": "itmosoft/laravel-tenders",
  "description": "Tender publishing and bid submission workflows for Laravel applications, with deadlines, polymorphic issuers and bidders, evaluation scores, and award tracking.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "illuminate/support": "^12.0 || ^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ITMOSOFT\\Tenders\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ITMOSOFT\\Tenders\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ITMOSOFT\\Tenders\\TendersServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit",
    "test-coverage": "phpunit --coverage-text"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
